# ============================================================
#  GAVA Recruitment CRM — Environment Variables
#  Copy this file to ".env" and fill in your values.
#  Never share the .env file with anyone.
# ============================================================

# ── Yelp API (required for scraping) ────────────────────────
# Get a free key at: https://www.yelp.com/developers/documentation/v3/authentication
# Free tier: 500 API calls per day
YELP_API_KEY=your_yelp_api_key_here

# ── Anthropic / Claude API (required for AI email drafting) ─
# Get your key at: https://console.anthropic.com
# New accounts get free credits to start
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gmail (required for sending emails) ─────────────────────
# Use your full Gmail address
GMAIL_ADDRESS=yourname@gmail.com
# Use an "App Password", NOT your regular Gmail password.
# How to create one:
#   1. Go to your Google Account → Security
#   2. Turn on 2-Step Verification (if not already on)
#   3. Go to Security → "App passwords"
#   4. Select "Mail" and your device → click Generate
#   5. Copy the 16-character password below (no spaces)
GMAIL_APP_PASSWORD=your_16_char_app_password
