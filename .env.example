# ============================================================
#  GAVA Recruitment CRM — Environment Variables
#  Copy this file to ".env" and fill in your values.
#  Never share the .env file with anyone.
# ============================================================

# ── Yelp API (free — best for restaurants, hotels, local businesses) ────────
# 1. Go to https://www.yelp.com/fusion
# 2. Click "Get Started" and create a free account
# 3. Create an App → copy the "API Key"
# Free tier: 500 calls per day
YELP_API_KEY=your_yelp_api_key_here

# ── Google Places API (most accurate — best coverage of US/Canada) ───────────
# 1. Go to https://console.cloud.google.com
# 2. Create a new project (or use existing)
# 3. Search for "Places API" and enable it
# 4. Go to Credentials → Create Credentials → API Key
# Free credit: $200/month (covers ~11,000 place searches — plenty for normal use)
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── Apollo.io API (finds HR contacts & emails at companies) ──────────────────
# 1. Go to https://www.apollo.io and create a free account
# 2. Go to Settings → Integrations → API
# 3. Copy your API key
# Free tier: 50 email reveals/month. Paid plans from $49/month for more.
APOLLO_API_KEY=your_apollo_api_key_here

# ── Anthropic / Claude API (required for AI email drafting) ──────────────────
# 1. Go to https://console.anthropic.com
# 2. Click API Keys → Create Key
# New accounts get free credits to start
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Gmail (required for sending emails from the app) ─────────────────────────
# Use your full Gmail address
GMAIL_ADDRESS=yourname@gmail.com
# Use an "App Password" — NOT your regular Gmail password.
# How to create one:
#   1. Go to myaccount.google.com → Security
#   2. Turn on 2-Step Verification (if not already on)
#   3. Go back to Security → search "App passwords"
#   4. Select App = "Mail", Device = "Windows Computer" → Generate
#   5. Copy the 16-character password here (no spaces needed)
GMAIL_APP_PASSWORD=your_16_char_app_password
